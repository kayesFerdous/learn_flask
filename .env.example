# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored. This file is committed, so it documents which variables
# the app needs without leaking any actual secrets.

# --- Local development (docker compose) -------------------------------------
# The `db` service creates this user/database on first boot.
POSTGRES_USER=learnflask
POSTGRES_PASSWORD=changeme
POSTGRES_DB=learnflask

# create_app() reads this. Falls back to sqlite:///data.db if unset.
#   postgresql+psycopg  -> dialect + driver. The `+psycopg` is required;
#                          without it SQLAlchemy looks for psycopg2, which
#                          this project does not install.
#   @localhost:5432      -> the port the db container publishes to your
#                           Mac. docker-compose.yml overrides this with
#                           `@db:5432` inside the network.
DATABASE_URL=postgresql+psycopg://learnflask:changeme@localhost:5432/learnflask

# Anyone who knows this can forge a token for any user. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=generate-your-own-do-not-use-this-value

# --- Production (Neon + Render) ---------------------------------------------
# Do NOT put production values in a file. Set them in Render's Environment tab.
# Neon hands you a URL like this -- add `+psycopg` and keep `?sslmode=require`:
#
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# Prefer Neon's `-pooler` host: gunicorn opens several connections at once.
