# Virtualenv — host-specific paths, would break inside the image
.venv

# Version control & docs
.git
.gitignore
CLAUDE.md

# Python build noise
__pycache__/
*.py[oc]
*.egg-info
build/
dist/
wheels/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets — never bake these into an image
.env
*.env

# Flask instance folder — your local sqlite db lives here. git ignores it, so
# without this line local images get a pre-made database that Render never has,
# and "works locally, broken on deploy" bugs stay hidden.
**/instance/
**/*.db

# Docker's own files aren't needed inside the image
Dockerfile
.dockerignore
